      "op": "test",
      "variable": "nftf",
      "operator": "is_true"
     }
    }
   ]
  },
  {
   "code": "ilp_with_nftf",
   "versions": [
    {
     "name": "ILP with NFTF",
     "description": "Both at once.",
     "expr": {
      "op": "all",
      "args": [
