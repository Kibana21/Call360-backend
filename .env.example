# Development configuration (copy to .env; .env is gitignored). No real values here.
APP_ENV=local
DATA_POLICY=SYNTHETIC_ONLY
APP_DATABASE_URL=postgresql+psycopg://Call360_db_user:<password>@localhost:5432/Call360_db
APP_DB_SCHEMA=call360
EXPECTED_DATABASE=Call360_db
EXPECTED_DB_ROLE=Call360_db_user
JWT_PRIVATE_KEY_PATH=.secrets/jwt_ed25519_private.pem
JWT_PUBLIC_KEY_PATH=.secrets/jwt_ed25519_public.pem
REFRESH_TOKEN_PEPPER=<generated by make env>
CSRF_SECRET=<generated by make env>
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
PII_ENCRYPTION_KEY=<generated by scripts/make_data_keys.py>
PII_HMAC_KEY=<generated by scripts/make_data_keys.py>
RECORDING_ENCRYPTION_KEY=<generated by scripts/make_data_keys.py; S1-C>
# RECORDING_STORAGE_DIR=~/.call360/recordings   (outside the repository; one sub-directory per schema)
# RECORDING_RETENTION_HOURS=168                  (local development setting, not a retention policy)
# S1-D transcription: local faster-whisper small.en model directory (outside Git; see Call360-specs S1.md "S1-D").
# TRANSCRIPTION_MODEL_DIR=~/.call360/models/faster-whisper-small.en
# TRANSCRIPT_LOW_LOGPROB=-0.6
# TRANSCRIPT_WORD_PROB=0.5
